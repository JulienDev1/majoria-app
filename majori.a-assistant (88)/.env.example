# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE INTEGRATION (Optional - can also be configured directly in Settings UI)
# VITE_SUPABASE_URL: URL of your Supabase project (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL="https://your-project.supabase.co"
# VITE_SUPABASE_ANON_KEY: Public Anon Key for client/server RPC use_credit calls
VITE_SUPABASE_ANON_KEY="your-anon-key"

# STRIPE INTEGRATION
# STRIPE_SECRET_KEY: Secret Key from Stripe dashboard
STRIPE_SECRET_KEY="sk_live_..."
# VITE_STRIPE_PUBLIC_KEY: Public Key from Stripe dashboard
VITE_STRIPE_PUBLIC_KEY="pk_live_..."
